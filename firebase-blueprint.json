{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "A client record containing personal details and notes.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "birthDate": { "type": "string" },
        "birthTime": { "type": "string" },
        "birthLocation": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "authorUid": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["name", "authorUid", "createdAt"]
    },
    "Consultation": {
      "title": "Consultation",
      "description": "A record of a consultation session with a client.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "date": { "type": "timestamp" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "type": { "type": "string" },
        "price": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "refunded"] },
        "authorUid": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["clientId", "date", "status", "authorUid", "createdAt"]
    }
  },
  "firestore": {
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Stores client records."
    },
    "/consultations/{consultationId}": {
      "schema": { "$ref": "#/entities/Consultation" },
      "description": "Stores consultation records."
    }
  }
}
