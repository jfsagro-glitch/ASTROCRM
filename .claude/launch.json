{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "frontend/node_modules/vite/bin/vite.js",
        "frontend",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "astro_api:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}