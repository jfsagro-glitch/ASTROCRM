{
  "name": "holo-astrocrm",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "HOLO Astrology CRM - React frontend, Python astrology API, optional Gemini proxy",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python -m uvicorn astro_api:app --reload --host 0.0.0.0 --port 8000",
    "dev:proxy": "tsx server/aiProxy.ts",
    "dev:api": "npm run dev:proxy",
    "build": "npm --prefix frontend install --include=dev --no-audit --no-fund && npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm run type-check",
    "type-check": "npm --prefix frontend ci --include=dev --no-audit --no-fund && tsc -p frontend/tsconfig.json --noEmit",
    "start": "npm run start:backend",
    "start:backend": "python -m uvicorn astro_api:app --host 0.0.0.0 --port 8000",
    "start:api": "npm run start:proxy",
    "start:proxy": "tsx server/aiProxy.ts",
    "install:all": "npm install && npm --prefix frontend install"
  },
  "dependencies": {
    "@google/genai": "^1.47.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.2",
    "tsx": "^4.21.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
